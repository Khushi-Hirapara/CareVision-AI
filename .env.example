# =============================================================================
# CareVision AI — Environment Variables (Example)
# =============================================================================
# Copy this file to `.env` in the project root and fill in values.
# Never commit `.env` or real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=CareVision AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Backend API
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_PREFIX=/api/v1

# JWT authentication
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# Frontend (build-time / client)
# -----------------------------------------------------------------------------
# Vite: VITE_*  |  Create React App: REACT_APP_*  |  Next.js: NEXT_PUBLIC_*
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=CareVision AI
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=carevision
POSTGRES_PASSWORD=change-me
POSTGRES_DB=carevision
DATABASE_URL=postgresql://carevision:change-me@localhost:5432/carevision

# -----------------------------------------------------------------------------
# Model & inference
# -----------------------------------------------------------------------------
MODEL_PATH=./backend/model/chest_xray_model.h5
MODEL_INPUT_SIZE=224
# Sigmoid decision threshold: pneumonia_prob >= value => Pneumonia (API), else Normal
PREDICTION_THRESHOLD=0.90
MODEL_CONFIDENCE_THRESHOLD=0.5
ENABLE_GRAD_CAM=true
# Optional: Keras layer for Grad-CAM (EfficientNet: top_conv). Empty = auto last Conv2D.
GRAD_CAM_LAYER_NAME=

# TensorFlow / GPU (optional)
TF_CPP_MIN_LOG_LEVEL=2
CUDA_VISIBLE_DEVICES=0
# USE_GPU=true

# -----------------------------------------------------------------------------
# File storage & uploads
# -----------------------------------------------------------------------------
UPLOAD_DIR=./backend/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png

# -----------------------------------------------------------------------------
# PDF reports
# -----------------------------------------------------------------------------
REPORTS_DIR=./backend/reports
REPORT_LOGO_PATH=

# -----------------------------------------------------------------------------
# Optional: email / notifications (future use)
# -----------------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@carevision.local
