# =============================================================================
# CareVision AI — Environment Variables (Example)
# =============================================================================
# Copy this file to `.env` in the project root and fill in values.
# Never commit `.env` or real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=CareVision AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Backend API
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
API_PREFIX=/api/v1

# JWT authentication
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=2

# Google OpenID Connect
# Create OAuth 2.0 Client (Web) in Google Cloud Console.
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/sso/google/callback

# Microsoft Entra ID OpenID Connect
# Register a Web app in Azure Portal → App registrations.
# Redirect URI must match MICROSOFT_REDIRECT_URI exactly.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Use "common" for personal + work accounts, or your tenant ID for one organization.
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/sso/microsoft/callback

# Optional; defaults to JWT_SECRET_KEY. Use a different long random value in production.
OAUTH_SESSION_SECRET=

# -----------------------------------------------------------------------------
# Frontend (build-time / client)
# -----------------------------------------------------------------------------
# Vite: VITE_*  |  Create React App: REACT_APP_*  |  Next.js: NEXT_PUBLIC_*
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=CareVision AI
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# When Google/Microsoft redirect URIs use ngrok, set this to the ngrok API origin.
# Leave unset to reuse NEXT_PUBLIC_API_BASE_URL.
# NEXT_PUBLIC_SSO_BASE_URL=https://your-tunnel.ngrok-free.dev
FRONTEND_URL=http://localhost:3000
# Optional: reachable URL for PDF QR codes (use LAN IP/domain when scanning from a phone)
# PUBLIC_FRONTEND_URL=http://192.168.1.10:3000

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=carevision
POSTGRES_PASSWORD=change-me
POSTGRES_DB=carevision
DATABASE_URL=postgresql://carevision:change-me@localhost:5432/carevision

# -----------------------------------------------------------------------------
# Model & inference
# -----------------------------------------------------------------------------
MODEL_VERSION=v1.0-efficientnetb0
MODEL_PATH=./backend/model/chest_xray_model.h5
MODEL_INPUT_SIZE=224
# Sigmoid decision threshold: pneumonia_prob >= value => Pneumonia (API), else Normal
PREDICTION_THRESHOLD=0.90
MODEL_CONFIDENCE_THRESHOLD=0.5
ENABLE_IMAGE_QUALITY_CHECK=true
MIN_IMAGE_DIMENSION=224
ENABLE_GRAD_CAM=true
# Optional: Keras layer for Grad-CAM (EfficientNet: top_conv). Empty = auto last Conv2D.
GRAD_CAM_LAYER_NAME=

# TensorFlow / GPU (optional)
# Applied to the process env on startup (see app/core/tf_env.py)
TF_ENABLE_ONEDNN_OPTS=0
TF_CPP_MIN_LOG_LEVEL=2
CUDA_VISIBLE_DEVICES=0
# USE_GPU=true

# -----------------------------------------------------------------------------
# File storage & uploads
# -----------------------------------------------------------------------------
UPLOAD_DIR=./backend/uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,dcm,dicom

# -----------------------------------------------------------------------------
# PDF reports
# -----------------------------------------------------------------------------
REPORTS_DIR=./backend/reports
REPORT_LOGO_PATH=
HOSPITAL_NAME=CareVision Medical Center
HOSPITAL_DEPARTMENT=Department of Radiology
HOSPITAL_ADDRESS=123 Healthcare Drive, Medical City
HOSPITAL_PHONE=+1 (555) 123-4567

# -----------------------------------------------------------------------------
# CareVision AI Health Assistant (Gemini)
# Explains saved reports only — does NOT analyze X-ray images.
# API key stays on the backend; never expose to the frontend.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_OUTPUT_TOKENS=2048

# -----------------------------------------------------------------------------
# Frontend & patient invitations
# -----------------------------------------------------------------------------
# FRONTEND_URL is also set above with the API/SSO section.
INVITATION_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Email (invitation links are logged when SMTP is unset; backend only)
# -----------------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@carevision.local
# SMTP_USE_TLS=true
