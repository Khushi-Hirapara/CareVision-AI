# Keep example or documented placeholders; ignore trained weights in model/
backend/model/**/*.h5
backend/model/**/*.keras
backend/model/**/*.pb
backend/model/checkpoints/
backend/model/logs/

# -----------------------------------------------------------------------------
# Dataset (large files — do not commit raw data)
# -----------------------------------------------------------------------------
dataset/raw/
dataset/processed/
dataset/**/*.zip
dataset/**/*.tar
dataset/**/*.tar.gz
dataset/**/*.7z
dataset/**/*.csv
dataset/**/*.jpg
dataset/**/*.jpeg
dataset/**/*.png
dataset/**/*.dcm
dataset/**/*.nii
dataset/**/*.nii.gz

# -----------------------------------------------------------------------------
# PostgreSQL & databases
# -----------------------------------------------------------------------------
*.sql.backup
*.dump
pgdata/
postgres-data/
.docker/postgres/

# -----------------------------------------------------------------------------
# VS Code & editors
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# -----------------------------------------------------------------------------
