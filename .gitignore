# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
*.tmp
*.temp
*.bak

# -----------------------------------------------------------------------------
# Uploads & generated reports (runtime)
# -----------------------------------------------------------------------------
uploads/
backend/uploads/
temp/
backend/temp/
reports/
backend/reports/


# -----------------------------------------------------------------------------
# Docker (local overrides)
# -----------------------------------------------------------------------------
docker-compose.override.yml

# Vercel / Next
.vercel/
frontend/.vercel/
frontend/.next/
frontend/out/

# Backend local files
backend/.venv/
backend/venv/

# Frontend env
frontend/.env
frontend/.env.*
frontend/.env.local

# Python cache anywhere
**/__pycache__/
**/*.pyc